# =================================================================
# SharePoint Clone - Environment Variables Configuration (.env.example)
# =================================================================

# ----------------- PostgreSQL Database -----------------
POSTGRES_USER=sharepoint
POSTGRES_PASSWORD=sp_pass123
POSTGRES_DB=sharepoint_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sharepoint:sp_pass123@localhost:5432/sharepoint_db

# ----------------- Redis Cache & Messaging -------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----------------- MinIO Object Storage (S3 API) -------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sp-documents
S3_REGION=us-east-1

# ----------------- Meilisearch Engine ------------------
MEILI_MASTER_KEY=masterKey123
MEILISEARCH_PORT=7700
MEILISEARCH_HOST=http://localhost:7700

# ----------------- Backend API -------------------------
BACKEND_PORT=5000
PORT=5000
JWT_SECRET=super-secret-jwt-key-sharepoint-clone-change-in-production
JWT_EXPIRATION=3600

# ----------------- Frontend Web ------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
